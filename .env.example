# --- Servidor ---
PORT=3000
NODE_ENV=development
NOME_LOCAL=Jukebox
# Hospedagem na internet (veja docs/HOSPEDAGEM.md)
# HOST=0.0.0.0
# TRUST_PROXY=true   # ligue atrás de proxy reverso/HTTPS (Render, Railway, Nginx, Cloudflare)
# Força a URL mostrada no QR code (se a detecção automática do IP do WiFi errar)
# PUBLIC_URL=http://192.168.1.100:3000

# --- Admin (/admin) ---
ADMIN_PASSWORD=troque-esta-senha
# Segredo pra assinar o token do admin. Se vazio, é gerado a cada reinício (admin precisa logar de novo).
# ADMIN_SECRET=

# --- Pagamento ---
# mock         = Pix de teste, créditos grátis (NÃO use em produção; o servidor recusa subir assim)
# mercadopago  = Pix real via Mercado Pago
PAYMENT_PROVIDER=mock
# Limite de cada compra por Pix ou cartão, em reais (dinheiro no noteiro não tem limite):
# VALOR_MIN=10
# VALOR_MAX=50
PIX_EXPIRA_MIN=15
MERCADOPAGO_ACCESS_TOKEN=
# Opcional: valida a assinatura dos webhooks (Mercado Pago > Suas integrações > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Opcional: só se o notebook for alcançável pela internet (ex.: túnel). Sem isso o sistema
# consulta os pagamentos em aberto a cada 5 segundos, o que dispensa webhook.
# WEBHOOK_PUBLIC_URL=https://seu-tunel.exemplo.com

# --- Regras de negócio ---
SESSAO_TTL_MIN=60        # créditos vencem após X min sem pagar/adicionar música
LANCAMENTO_DIAS=7        # tempo que um CD novo fica em LANÇAMENTOS
DIVISAO_USUARIO=50       # % do faturamento que fica com você (o resto é da boate)
FILA_MAX=60
CREDITOS_DONO_MAX=50     # teto dos créditos de cortesia do dono (1 vez por dia, sem Pix)

# --- Player ---
# auto = mpv, senão VLC, senão simulado (só em desenvolvimento) | mpv | vlc | sim
PLAYER=auto
# MPV_PATH=C:\mpv\mpv.exe
# VLC_PATH=C:\Program Files\VideoLAN\VLC\vlc.exe
PLAYER_SIM_SEGUNDOS=15

# --- Volume parelho (opcional) ---
# O ffmpeg mede o volume de cada música. Instale com: winget install Gyan.FFmpeg
# (feche o terminal, abra de novo e reinicie o servidor). Se não achar sozinho, aponte aqui:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe

# --- Músicas da internet (opcional; aba Internet do painel, desligado de fábrica) ---
# O yt-dlp baixa o áudio do YouTube. Instale com: winget install yt-dlp.yt-dlp
# (feche o servidor, abra um novo PowerShell e rode npm start). Se não for achado sozinho, aponte aqui:
# YTDLP_PATH=C:\yt-dlp\yt-dlp.exe
# Opções extras repassadas ao yt-dlp. Só use se o YouTube pedir login ("confirme que você não é um robô"):
# YTDLP_ARGS_EXTRA=--cookies-from-browser firefox
# Tempo máximo, em segundos, de cada pesquisa e de cada download:
# YTDLP_TEMPO_BUSCA_S=40
# YTDLP_TEMPO_BAIXAR_S=180

# --- Avisos no Telegram (opcional; veja docs/NOVAS-FUNCIONALIDADES.md) ---
# 1) No Telegram, fale com @BotFather, mande /newbot e copie o token para a linha abaixo e reinicie o servidor.
# 2) Mande "oi" para o seu bot, abra /admin -> Alertas e clique em "Descobrir minha conversa": ele mostra o TELEGRAM_CHAT_ID.
# O token e as conversas ficam só neste arquivo (não vão para o banco nem para os backups).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_ID_BOATE=   # contato da boate: recebe só a versão resumida do fechamento (sem a sua parte)

# --- Backup automático do banco (todo dia às 4h) ---
# BACKUP_DIR=backups
# BACKUP_MANTER=14        # quantos backups guardar
# BACKUP_COPIA_DIR=C:\Users\voce\OneDrive\jukebox-backups   # 2ª cópia (nuvem ou pendrive), opcional

# --- Caminhos (relativos à raiz do projeto) ---
# DB_PATH=database/jukebox.db
# MUSICAS_DIR=musicas
# IMPORT_DIR=musicas/_importar   # pasta onde você solta Artista/CD/faixas para importar em lote
# ACERVO_EXTERNO_DIR=/media/jukebox/HD/home/jkb/musicas   # acervo de outra jukebox (HD antigo): toca de lá, sem mover nada
